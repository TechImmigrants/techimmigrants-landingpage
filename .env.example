# Tech Immigrants website — environment variables
#
# ALL of these are OPTIONAL. With no .env file the site runs in "static mode":
# it shows sample session content and never makes a failing network call.
# Copy this file to .env and fill in values only if you want live data.

# --- Supabase (optional, client-side video/session data) ---
# Public project URL and anon key. The anon key is safe to expose in the client.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- YouTube Data API (optional, CI only) ---
# Used ONLY by the GitHub Action (scripts/fetch-upcoming-lives.mjs) to refresh
# upcoming live events. It is never bundled into client code.
# Add this as a GitHub repository SECRET, not as a VITE_ variable.
YOUTUBE_API_KEY=your-youtube-api-key-here
